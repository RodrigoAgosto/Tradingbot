# Copy to a key file OUTSIDE version control, e.g. ~/.weatherbot.env
# then: chmod 600 ~/.weatherbot.env
#
# The launchd wrapper (ops/run_cycle.sh) sources this file. It is NEVER
# committed; .gitignore excludes .env* and the pre-commit hook scans for
# key material.

# "paper" (default) or "live". Live additionally requires the
# --i-understand-this-is-live CLI flag on every invocation.
TRADING_MODE=paper

# --- Live trading only (leave empty in paper mode) -------------------------
# Polygon private key for the wallet that trades on Polymarket.
# NEVER paste this anywhere else. It is redacted from all logs.
POLYMARKET_PRIVATE_KEY=
# Polymarket proxy wallet (funder) address, 0x...
POLYMARKET_PROXY_ADDRESS=

# --- Alerts ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
SMTP_USERNAME=
SMTP_PASSWORD=
