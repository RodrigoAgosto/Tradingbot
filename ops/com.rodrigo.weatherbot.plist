<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rodrigo.weatherbot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__REPO_DIR__/ops/run_cycle.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>1200</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/weatherbot/cycle.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/weatherbot/cycle.err.log</string>

    <!-- Secrets are sourced from the 600-perm key file inside run_cycle.sh,
         never inlined here. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>WEATHERBOT_KEY_FILE</key>
        <string>__HOME__/.weatherbot.env</string>
    </dict>
</dict>
</plist>
