<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rodrigo.weatherbot.review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd __REPO_DIR__ &amp;&amp; set -a &amp;&amp; source __HOME__/.weatherbot.env &amp;&amp; set +a &amp;&amp; uv run python scripts/review.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/weatherbot/review.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/weatherbot/review.err.log</string>
</dict>
</plist>
